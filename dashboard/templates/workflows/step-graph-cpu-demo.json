{
  "version": 1,
  "name": "CPU 双层训练图",
  "execution_profile": "dag-runtime",
  "nodes": [
    {
      "id": "ds",
      "kind": "dataset",
      "target": "registry:SyntheticClassificationDataset",
      "params": {
        "num_samples": 64,
        "input_shape": [
          4
        ],
        "num_classes": 2,
        "seed": 7,
        "sample_format": "dict"
      },
      "position": {
        "x": 40,
        "y": 40
      },
      "metadata": {
        "label": "合成数据"
      }
    },
    {
      "id": "dl",
      "kind": "dataloader",
      "target": "builtin:DataLoader",
      "params": {
        "num_workers": 0,
        "shuffle": true,
        "drop_last": false,
        "pin_memory": false,
        "batch_size": 8
      },
      "position": {
        "x": 540,
        "y": 40
      },
      "metadata": {
        "label": "批次"
      }
    },
    {
      "id": "loss",
      "kind": "loss",
      "target": "torch.nn:CrossEntropyLoss",
      "params": {},
      "position": {
        "x": 40,
        "y": 180
      },
      "metadata": {
        "label": "交叉熵"
      }
    },
    {
      "id": "model",
      "kind": "model",
      "target": "registry:simple_mlp",
      "params": {
        "input_size": 4,
        "hidden_size": 32,
        "num_classes": 2,
        "dropout_rate": 0.0
      },
      "position": {
        "x": 40,
        "y": 300
      },
      "metadata": {
        "label": "MLP"
      }
    },
    {
      "id": "opt",
      "kind": "optimizer",
      "target": "torch.optim:Adam",
      "params": {
        "lr": 0.01
      },
      "position": {
        "x": 260,
        "y": 300
      },
      "metadata": {
        "label": "Adam"
      }
    },
    {
      "id": "trainer",
      "kind": "trainer",
      "target": "builtin:Trainer",
      "params": {
        "max_epochs": 1,
        "batch_size": 16,
        "gradient_accumulation_steps": 2,
        "precision": "32"
      },
      "position": {
        "x": 840,
        "y": 160
      },
      "metadata": {
        "label": "训练循环"
      }
    },
    {
      "id": "split",
      "kind": "dataset_split",
      "target": "builtin:DatasetSplit",
      "params": {
        "val_ratio": 0.25,
        "seed": 7
      },
      "position": {
        "x": 280,
        "y": 40
      }
    },
    {
      "id": "collate",
      "kind": "collate",
      "target": "registry:DictCollate",
      "params": {},
      "position": {
        "x": 280,
        "y": 230
      }
    },
    {
      "id": "val",
      "kind": "dataloader",
      "target": "builtin:DataLoader",
      "params": {
        "batch_size": 8,
        "shuffle": false
      },
      "position": {
        "x": 540,
        "y": 230
      }
    }
  ],
  "edges": [
    {
      "id": "e-dl",
      "from": {
        "node": "dl",
        "port": "batches"
      },
      "to": {
        "node": "trainer",
        "port": "train_loader"
      }
    },
    {
      "id": "e-loss",
      "from": {
        "node": "loss",
        "port": "loss"
      },
      "to": {
        "node": "trainer",
        "port": "loss"
      }
    },
    {
      "id": "e-model",
      "from": {
        "node": "model",
        "port": "module"
      },
      "to": {
        "node": "trainer",
        "port": "model"
      }
    },
    {
      "id": "e-opt",
      "from": {
        "node": "opt",
        "port": "optimizer"
      },
      "to": {
        "node": "trainer",
        "port": "optimizer"
      }
    },
    {
      "id": "e-opt-model",
      "from": {
        "node": "model",
        "port": "module"
      },
      "to": {
        "node": "opt",
        "port": "model"
      }
    },
    {
      "id": "e-split",
      "from": {
        "node": "ds",
        "port": "samples"
      },
      "to": {
        "node": "split",
        "port": "dataset"
      }
    },
    {
      "id": "e-train",
      "from": {
        "node": "split",
        "port": "train"
      },
      "to": {
        "node": "dl",
        "port": "dataset"
      }
    },
    {
      "id": "e-val",
      "from": {
        "node": "split",
        "port": "val"
      },
      "to": {
        "node": "val",
        "port": "dataset"
      }
    },
    {
      "id": "e-train-collate",
      "from": {
        "node": "collate",
        "port": "collate"
      },
      "to": {
        "node": "dl",
        "port": "collate"
      }
    },
    {
      "id": "e-val-collate",
      "from": {
        "node": "collate",
        "port": "collate"
      },
      "to": {
        "node": "val",
        "port": "collate"
      }
    },
    {
      "id": "e-val-batches",
      "from": {
        "node": "val",
        "port": "batches"
      },
      "to": {
        "node": "trainer",
        "port": "val_loader"
      }
    }
  ],
  "settings": {
    "launcher": "none",
    "devices": [],
    "runtime": {
      "seed": 42
    }
  },
