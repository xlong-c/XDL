        "to": {
          "node": "x",
          "port": "batch"
        }
      },
      {
        "id": "s2",
        "from": {
          "node": "batch",
          "port": "batch"
        },
        "to": {
          "node": "y",
          "port": "batch"
        }
      },
      {
