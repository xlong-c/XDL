{
  "$schema": "https://opencode.ai/config.json",
  "skill": {
    "name": "gitu",
    "version": "1.0.0",
    "description": "自动 Git 提交推送工具 - 智能生成提交描述并提交推送所有代码变更",
    "author": "XDL Team",
    "license": "MIT"
  },
  "mcp": {
    "name": "gitu-mcp",
    "type": "stdio",
    "command": "python",
    "args": ["-m", "gitu.mcp_server"],
    "cwd": "./gitu",
    "env": {
      "PYTHONPATH": "./gitu"
    }
  },
  "tools": [
    {
      "name": "auto_commit",
      "description": "自动分析代码变更，生成智能提交描述，执行 git add、commit 和 push 一键提交推送所有变更",
      "inputSchema": {
        "type": "object",
        "properties": {
          "cwd": {
            "type": "string",
            "description": "工作目录路径（默认当前目录）",
            "default": "."
          },
          "push": {
            "type": "boolean",
            "description": "是否自动推送到远程仓库（默认 true）",
            "default": true
          },
          "remote": {
            "type": "string",
            "description": "远程仓库名称（默认 origin）",
            "default": "origin"
          },
          "branch": {
            "type": "string",
            "description": "分支名称（不指定则使用当前分支）"
          }
        },
        "required": []
      }
    }
  ]
}
