{
    "typeCheckingMode": "basic",
    "pythonVersion": "3.12",
    "extraPaths": [
        "xdl-jax"
    ],
    "include": [
        "xdl",
        "tests",
        "config",
        "examples",
        "infer",
        "train",
        "scripts",
        "tools"
    ],
    "exclude": [
        "**/__pycache__",
        "**/.mypy_cache",
        "**/.pytest_cache",
        "**/.ruff_cache",
        "**/.venv",
        "data",
        "downloads",
        "third_party"
    ]
}
