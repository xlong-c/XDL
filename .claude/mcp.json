        "PYTHONPATH": "/root/workspace/xdl/sci_research"
      }
    },
    "example-skill": {
      "command": "python",
      "args": [
        "-m",
        "example_skill.mcp_server"
      ],
      "cwd": "/root/workspace/xdl/example_skill",
      "env": {
        "PYTHONPATH": "/root/workspace/xdl/example_skill"
      }
    }
  }
}