{
  "mcpServers": {
    "gitu": {
      "command": "python",
      "args": [
        "-m",
        "gitu.mcp_server"
      ],
      "cwd": "/root/workspace/xdl/gitu",
      "env": {
        "PYTHONPATH": "/root/workspace/xdl/gitu"
      }
    },
    "research-tools": {
      "command": "python",
      "args": [
        "-m",
        "skills.mcp_server"
      ],
      "cwd": "/root/workspace/xdl/sci_research",
